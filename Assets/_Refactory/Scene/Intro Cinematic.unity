  m_Script: {fileID: 11500000, guid: 823257a19ea7c0c44a56eea060609580, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Cinematics.IntroCinematicController
  director: {fileID: 139653679}
  playOnStart: 1
  dialogueRoot: {fileID: 1003037039}
  dialogueText: {fileID: 371397059}
  dialogueLines:
  - text: Hello Travelers!
  - text: Welcome to my humble home.
  - text: "This is where my story ends\u2026"
  - text: ...after years of glorious adventures...
  - text: "finally, a chance to relax\u2026"
  - text: ... i need my goodnight potion.
  - text: Which potion is it, you ask?
  - text: All of them, of course!
  - text: "This is the dark tale of a powerful Red Mage\u2026"
  - text: who fell into a spiral of thirst and excess.
  loadMainMenuOnFinish: 1
  mainMenuSceneName: Main Menu
  allowSkip: 1
