  idleFrameRate: 12
  description: "Fragile but versatile, the Mage uses light, healing and cleansing to keep the night under control."
  transformationMethod: "The starting form."
  transformationPotionSprites: []
  transformationHint: ""
  cureMethod: "Your natural form. There is no transformation to reverse."
  immunePotionSprites: []
  spells:
  - nome: Light
    costo: 1
    icona: {fileID: 21300000, guid: 59d21fb437c9db24c9e9ebe2838a386d, type: 3}
    audio: {fileID: 8300000, guid: e1b7e4d30089aac4bb39f5af0c9abcf3, type: 3}
    descrizioneNormale: "Raises light intensity by 1 level (maximum: 3)."
    descrizionePotenziata: "At light level 3, casting is blocked and no mana is spent."
    descrizioneBreve: "Raise light by 1 level."
  - nome: Heal
    costo: 4
    icona: {fileID: 21300000, guid: 5cd7861c3b4c54b4b9323f5cc6c6e3ed, type: 3}
    audio: {fileID: 8300000, guid: e1b7e4d30089aac4bb39f5af0c9abcf3, type: 3}
    descrizioneNormale: "Restores 3 HP. Cannot be cast at full health."
    descrizionePotenziata: "At light level 3: restores 4 HP instead of 3."
    descrizioneBreve: "Heal 3 HP; 4 at full light."
  - nome: Cleanse
    costo: 6
    icona: {fileID: 21300000, guid: bd969a873597b14448c3e80f9e73f4c8, type: 3}
    audio: {fileID: 8300000, guid: e1b7e4d30089aac4bb39f5af0c9abcf3, type: 3}
    descrizioneNormale: "Removes Burn, Grass, Wet, Ice, Poison and Grounded. Does not remove Algae, Bless or Curse. Requires at least one removable status."
    descrizionePotenziata: "At light level 3: removes the same statuses and restores 1 HP."
    descrizioneBreve: "Remove basic ailments; +1 HP at full light."

