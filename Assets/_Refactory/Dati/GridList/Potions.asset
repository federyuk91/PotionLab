    animationFrameRate: 12
    unlockedByDefault: 1
    sceneBuildIndex: -1
  - id: "Fire_Potion"
    displayName: "Fire Potion"
    description: "Great for drying yourself off or lighting up some weeds. Thaws chilly fingers, warms cold bones, and should never be mixed carelessly with poison."
    sprite: {fileID: -2172864323747464720, guid: edab2cf6e83ce054aa717b7051e46c14, type: 3}
    animationFrames:
    - {fileID: -818994644622335576, guid: edab2cf6e83ce054aa717b7051e46c14, type: 3}
    - {fileID: 6695512830216543636, guid: edab2cf6e83ce054aa717b7051e46c14, type: 3}
