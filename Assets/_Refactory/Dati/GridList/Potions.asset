    unlockedByDefault: 1
    sceneBuildIndex: -1
  - id: "Lava_Potion"
    displayName: "Lava Potion"
    description: "Bottled fury from beneath the earth. Merciless to flesh, surprisingly useful against the cold, and strangely tempting when you are already burning."
    sprite: {fileID: -8366473302825249247, guid: 0c2a77bcd3e4413429911e488f313155, type: 3}
    animationFrames:
    - {fileID: -6229212478814258359, guid: 0c2a77bcd3e4413429911e488f313155, type: 3}
    - {fileID: -8366473302825249247, guid: 0c2a77bcd3e4413429911e488f313155, type: 3}
