    animationFrameRate: 12
    unlockedByDefault: 1
    sceneBuildIndex: -1
  - id: "Ground_Potion"
    displayName: "Ground Potion"
    description: "A handful of earth to smother some flames. Helps dry a soggy robe and keeps unruly greenery under control. Try not to bury yourself in the process."
    sprite: {fileID: 909782368918440197, guid: 1a103b75ec8e47743b5cab6823f048c3, type: 3}
    animationFrames:
    - {fileID: 909782368918440197, guid: 1a103b75ec8e47743b5cab6823f048c3, type: 3}
    - {fileID: 1358720898326617198, guid: 1a103b75ec8e47743b5cab6823f048c3, type: 3}
