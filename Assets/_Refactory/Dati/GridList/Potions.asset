    animationFrameRate: 12
    unlockedByDefault: 1
    sceneBuildIndex: -1
  - id: "Water_Potion"
    displayName: "Water Potion"
    description: "Some fresh water, always useful and refreshing. Washes away unpleasant surprises and settles fiery tempers. Be careful what you water—and what you pour it over when frozen."
    sprite: {fileID: 3833926529033503733, guid: 1a1694ee82ded3342bde68515610b0d6, type: 3}
    animationFrames:
    - {fileID: 3833926529033503733, guid: 1a1694ee82ded3342bde68515610b0d6, type: 3}
    - {fileID: 9002340328652074540, guid: 1a1694ee82ded3342bde68515610b0d6, type: 3}
