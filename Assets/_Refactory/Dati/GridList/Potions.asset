    animationFrameRate: 12
    unlockedByDefault: 1
    sceneBuildIndex: -1
  - id: "Poison_Potion"
    displayName: "Poison Potion"
    description: "Don’t drink poison. A little greenery might spare you the worst, but fire makes it dangerously excitable. Drinking it while soaking wet could leave you feeling rather fishy."
    sprite: {fileID: -517353636276603117, guid: 88bee5b2da11771489473878b514bbfb, type: 3}
    animationFrames:
    - {fileID: 7266228807692468408, guid: 88bee5b2da11771489473878b514bbfb, type: 3}
