  - id: "Large_Health_Potion"
    displayName: "Large Health Potion"
    description: "A generous dose of second chances. For nights when a small sip simply won’t put you back together."
    sprite: {fileID: -1834088911562275152, guid: 3bcbfe3450d294a45a466ee92b5a7219, type: 3}
    animationFrames:
    - {fileID: -1834088911562275152, guid: 3bcbfe3450d294a45a466ee92b5a7219, type: 3}
