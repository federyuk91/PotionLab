    animationFrameRate: 12
    unlockedByDefault: 1
    sceneBuildIndex: -1
  - id: "Small_Light_Potion"
    displayName: "Small Light Potion"
    description: "A little light and a little magic for a weary wizard. Enough to brighten a gloomy moment. Even a small spark feels different when you are already brimming with power."
    sprite: {fileID: 8897779110357489536, guid: f7f07477b3f60e94087be0d65b69b410, type: 3}
    animationFrames:
    - {fileID: 6468837596063034635, guid: f7f07477b3f60e94087be0d65b69b410, type: 3}
