    animationFrameRate: 12
    unlockedByDefault: 1
    sceneBuildIndex: -1
  - id: "Ice_Potion"
    displayName: "Ice Potion"
    description: "A bitter chill to freeze your heart and silence an unruly garden. Takes the heat out of a bad situation, but wet robes make poor winter clothing."
    sprite: {fileID: -6273755256659582499, guid: df86eb8c0b6abf0499a295c1d9b330b3, type: 3}
    animationFrames:
    - {fileID: 8456340560046226029, guid: df86eb8c0b6abf0499a295c1d9b330b3, type: 3}
