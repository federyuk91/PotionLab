    unlockedByDefault: 1
    sceneBuildIndex: -1
  - id: "Dark_Potion"
    displayName: "Dark Potion"
    description: "It drains your magic and occasionally your health. Once your magical reserves run dry, it starts collecting a more personal payment. Some forms, however, have acquired a taste for it."
    sprite: {fileID: -5469023944784030602, guid: 531bc38a7e672414482189974260f0f8, type: 3}
    animationFrames:
    - {fileID: -144116324112393674, guid: 531bc38a7e672414482189974260f0f8, type: 3}
