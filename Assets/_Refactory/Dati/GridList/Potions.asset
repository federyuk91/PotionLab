    unlockedByDefault: 1
    sceneBuildIndex: -1
  - id: "Light_Potion"
    displayName: "Light Potion"
    description: "Bring some light to the lab and put a little wonder back in your wand. Chases away darker influences. A wizard already full of magic may find it especially uplifting."
    sprite: {fileID: 2202341305063842851, guid: 6a03806f08d40034fa2368e51554b262, type: 3}
    animationFrames:
    - {fileID: 537329105770137586, guid: 6a03806f08d40034fa2368e51554b262, type: 3}
