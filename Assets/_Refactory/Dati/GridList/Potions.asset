    animationFrameRate: 12
    unlockedByDefault: 1
    sceneBuildIndex: -1
  - id: "Empty_potion"
    displayName: "Empty potion"
    description: "I hate these empty bottles. Smash them! No remedy, no magic, not even a disappointing sip—just glass taking up valuable potion space."
    sprite: {fileID: 21300000, guid: ef82a48044edd41449c29d52a5e2cdb8, type: 3}
    unlockedByDefault: 1
    sceneBuildIndex: -1
