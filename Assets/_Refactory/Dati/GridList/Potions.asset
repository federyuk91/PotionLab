  - id: "Health_Potion"
    displayName: "Health Potion"
    description: "A dependable remedy for a difficult night. Best enjoyed before your wounds become someone else’s problem."
    sprite: {fileID: 4541355803882593998, guid: 4519fb72ad3086c4197faba476ecdb1d, type: 3}
    animationFrames:
    - {fileID: -6716467235744403431, guid: 4519fb72ad3086c4197faba476ecdb1d, type: 3}
