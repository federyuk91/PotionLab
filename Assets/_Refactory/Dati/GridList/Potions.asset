    animationFrameRate: 12
    unlockedByDefault: 1
    sceneBuildIndex: -1
  - id: "Seed_Potion"
    displayName: "Seed Potion"
    description: "Some excellent seeds. They grow very fast. A little water can work wonders, good soil helps them thrive, and open flames are a terrible gardening companion."
    sprite: {fileID: 8392550403479288723, guid: c46ed72b71de0254e8f156952ce6a115, type: 3}
    animationFrames:
    - {fileID: 8392550403479288723, guid: c46ed72b71de0254e8f156952ce6a115, type: 3}
